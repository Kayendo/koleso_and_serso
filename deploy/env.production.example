# Скопируй на сервер как /opt/kolesoblya/.env
# Сгенерируй SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"

FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

SECRET_KEY=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ

# Если заходишь по IP или домену — укажи здесь (через запятую)
# ALLOWED_ORIGINS=http://123.45.67.89,https://dotag.tvoi-domen.ru

COMMENTATOR_ENABLED=1
COMMENTATOR_INTERVAL_MIN=30
COMMENTATOR_INTERVAL_MAX=40
COMMENTATOR_FIRST_DELAY=12

AI_TTS_VOICE=random
AI_TTS_POOL=characters

TENOR_POOL_REFRESH_ENABLED=1
TENOR_POOL_REFRESH_SEC=3600
